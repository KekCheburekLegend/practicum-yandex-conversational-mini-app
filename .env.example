# Development-only values. Copy this file to .env and change credentials as needed.
POSTGRES_DB=miniapp
POSTGRES_USER=miniapp
POSTGRES_PASSWORD=localdevpassword
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional RustFS profile (S3-compatible storage).
RUSTFS_ACCESS_KEY=localdevaccess
RUSTFS_SECRET_KEY=localdevsecret123
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
